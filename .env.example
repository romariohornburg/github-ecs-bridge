# GitHub webhook secret (set when configuring the webhook on GitHub)
WEBHOOK_SECRET=your_github_webhook_secret_here

# Elasticsearch connection
ELASTICSEARCH_URL=https://localhost:9200
# Pre-encoded API key as returned by ES POST /_security/api_key (the "encoded" field)
ELASTICSEARCH_API_KEY=your_base64_encoded_api_key_here

# Target data stream (default: logs-github.audit-default)
# ELASTICSEARCH_INDEX=logs-github.audit-default

# Bind address (default: 0.0.0.0:3001)
# LISTEN_ADDR=0.0.0.0:3001

# Enable the unauthenticated /debug/webhook endpoint — NEVER enable in production (default: false)
# DEBUG_ENDPOINT_ENABLED=false

# Elasticsearch request timeout in seconds (default: 30)
# ES_TIMEOUT_SECS=30

# Log level
RUST_LOG=info,github_webhook_ingester=debug
